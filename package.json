{
  "name": "hacknation-7",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL next dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "next build",
    "start": "env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "eval": "node scripts/eval.mjs",
    "mock": "node scripts/mock-llm.mjs",
    "check": "bash scripts/check.sh",
    "extract": "tsx scripts/extract.ts",
    "geocode": "tsx scripts/geocode-addresses.ts",
    "lookups": "tsx scripts/lookup.ts",
    "changes": "tsx scripts/changes.ts",
    "score": "python3 scripts/selfscore.py",
    "review": "python3 scripts/review-sheets.py",
    "pipeline": "npm run lookups && npm run changes && npm run score",
    "ingest": "tsx scripts/ingest.ts",
    "capture": "python3 scripts/capture-source.py",
    "translate": "tsx scripts/translate.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "next": "16.3.8",
    "openai": "^7.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
