# Copy to .env.local for local dev. On Vercel, add the same names under
# Project > Settings > Environment Variables. Never commit real keys.

# Set one key. If both are set, LLM_PROVIDER picks (anthropic or openai);
# otherwise Anthropic is used when its key is present.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_MODEL=gpt-6.1-sol

# Limits for the public demo
LLM_MAX_TOKENS=8192
MAX_INPUT_CHARS=20000
RATE_LIMIT_PER_10_MIN=30
